#!/usr/bin/python3
"""One-shot SNTP client for the Xiaomi 12 port.

The minimal rootfs has no chrony/timesyncd, so this small client sets the
system clock from a few public NTP servers and then programs the PMK8350 RTC.
It is run by cupid-timesync.timer at boot and once an hour.
"""
import fcntl
import os
import socket
import struct
import sys
import time

NTP_DELTA = 2208988800
RTC_SET_TIME = 0x4024700A
SERVERS = (
    "ntp.aliyun.com",
    "cn.pool.ntp.org",
    "time.cloudflare.com",
    "223.5.5.5",
    "119.28.183.184",
)


def query(host, timeout=3.0):
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.settimeout(timeout)
    try:
        sock.sendto(b"\x1b" + 47 * b"\0", (host, 123))
        data, _ = sock.recvfrom(48)
    finally:
        sock.close()
    if len(data) < 48:
        raise OSError("short NTP reply")
    seconds, fraction = struct.unpack("!II", data[40:48])
    return seconds - NTP_DELTA + fraction / 2**32


def set_rtc():
    now = time.gmtime()
    buf = struct.pack(
        "9I",
        now.tm_sec, now.tm_min, now.tm_hour,
        now.tm_mday, now.tm_mon - 1, now.tm_year - 1900,
        now.tm_wday, now.tm_yday, 0,
    )
    try:
        fd = os.open("/dev/rtc0", os.O_RDONLY)
        try:
            fcntl.ioctl(fd, RTC_SET_TIME, buf)
        finally:
            os.close(fd)
    except OSError as exc:
        print(f"cupid-timesync: RTC write failed: {exc}", file=sys.stderr)


def main():
    for server in SERVERS:
        try:
            stamp = query(server)
        except OSError as exc:
            print(f"cupid-timesync: {server}: {exc}", file=sys.stderr)
            continue
        time.clock_settime(time.CLOCK_REALTIME, stamp)
        print(f"cupid-timesync: set from {server}: {time.strftime('%Y-%m-%d %H:%M:%S', time.gmtime(stamp))} UTC")
        set_rtc()
        return 0
    return 1


if __name__ == "__main__":
    sys.exit(main())
