#!/usr/bin/python3
"""Write the current UTC system clock to the PMK8350 RTC.

The driver's legacy offset path needs an nvmem cell that this board does not
have; the node therefore carries allow-set-time and we program the hardware
clock directly with RTC_SET_TIME.
"""
import fcntl
import os
import struct
import sys
import time

RTC_SET_TIME = 0x4024700A
RTC = "/dev/rtc0"

try:
    now = time.gmtime()
    buf = struct.pack(
        "9I",
        now.tm_sec, now.tm_min, now.tm_hour,
        now.tm_mday, now.tm_mon - 1, now.tm_year - 1900,
        now.tm_wday, now.tm_yday, 0,
    )
    fd = os.open(RTC, os.O_RDONLY)
    try:
        fcntl.ioctl(fd, RTC_SET_TIME, buf)
    finally:
        os.close(fd)
except OSError as exc:
    print(f"cupid-rtc-save: {exc}", file=sys.stderr)
    sys.exit(1)
