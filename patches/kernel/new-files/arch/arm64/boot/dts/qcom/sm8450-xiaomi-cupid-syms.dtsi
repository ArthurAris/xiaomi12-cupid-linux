/*
 * DTBO / hypervisor overlay symbol placeholders (generated).
 *
 * ABL overlays the dtbo partition plus its built-in hypervisor (Gunyah)
 * runtime overlay onto the base DTB via libufdt. libufdt resolves every
 * fragment target through __fixups__ -> __symbols__ of the BASE tree, and
 * dtc only exports LABELS into __symbols__.
 *
 * The upstream tree only labels its own nodes, so an overlay that references
 * a downstream-only symbol makes the merge fail and ABL resets without any
 * message ("fastboot boot" still reports OKAY).
 *
 * This file exports the WHOLE symbol set of the stock base DTB (union), with
 * the labels the upstream tree already defines skipped - overlays target
 * those real nodes instead. Every placeholder sits in one container that is
 * status="disabled" and carries no compatible / address properties, so the
 * merged fragments never bind to a driver (a fake consumer would pin
 * regulators and clocks forever).
 */
/ {
	symcont: symbol-placeholders {
		status = "disabled";
		eusb2_phy0: ph_eusb2_phy0 { };
		tlmm: ph_tlmm { };
		APC1_pause: ph_APC1_pause { };
		APSS_OFF: ph_APSS_OFF { };
		BOB: ph_BOB { };
		BOB_AO: ph_BOB_AO { };
		CLUSTER_PD: ph_CLUSTER_PD { };
		CLUSTER_PWR_DN: ph_CLUSTER_PWR_DN { };
		CPU0: ph_CPU0 { };
